# ============================================
# PlagPro Chatbot - Environment Variables
# ============================================

# Your Google Cloud Project ID (e.g. plagpro-ai-123)
DIALOGFLOW_PROJECT_ID=your-project-id

# MongoDB Connection String (Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/plagpro

# Port the server will run on (3000 is default)
PORT=3000

# Company info
COMPANY_NAME=PlagPro
LOCATION=Noida, India

